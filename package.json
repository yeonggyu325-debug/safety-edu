{
  "name": "safety-edu-intranet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "start": "node server/server.cjs",
    "start:lan": "node server/server.cjs --lan",
    "test": "node --test tests/*.test.cjs",
    "backup": "node server/backup.cjs",
    "start:local": "node server/server.cjs",
    "backup:verify": "node server/backup.cjs --verify",
    "restore": "node server/backup.cjs --restore",
    "cloud:export": "node server/publish-library.cjs",
    "cloud:publish": "node --env-file=.env.local server/publish-library.cjs --apply"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2"
  }
}
